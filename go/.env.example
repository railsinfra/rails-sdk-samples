# Sign in at https://railsinfra.com and create a server API key — paste it below (server-side only; never commit real values).
RAILS_API_KEY=

# Environment base URL we provide — do not change unless Rails onboarding gave your institution a different base URL (no DB or internal topology in this value).
RAILS_BASE_URL=https://api.railsinfra.com

# Optional: when set, main.go calls Accounts.Get for this id
RAILS_SAMPLE_ACCOUNT_ID=

# --- sample HTTP API (go run ./cmd/sample-api) ---
# Listen port (default 8083)
PORT=8083

# Dev/staging only: skip TLS verify for outbound calls to Rails (Go equivalent of a custom trust store when PKIX/handshake fails).
# RAILS_INSECURE_SSL=true
