# Sign in at https://railsinfra.com and create a server API key — paste it here (never commit real values).
RAILS_API_KEY=
# Do not change — this is the API base URL we provide for these samples (only replace if Rails onboarding gave you a different base URL).
RAILS_BASE_URL=https://api.railsinfra.com
PORT=8081
# Dev/staging private CA only — forwarded (proxy) HTTP uses trust-all TLS. Does not change the SDK client.
RAILS_INSECURE_SSL=false
