{
  "name": "rails-sdk-sample-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Local demo server that calls the Rails API using RAILS_BASE_URL and RAILS_API_KEY (mirrors samples/kotlin patterns).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "@railsinfra/rails-typescript": "file:../../rails-sdks/rails-typescript",
    "swagger-ui-express": "^5.0.1",
    "undici": "^6.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
